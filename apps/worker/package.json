{
  "name": "@gulio/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @gulio/config --filter @gulio/contracts --filter @gulio/database run build",
    "dev": "tsx watch src/main.ts",
    "prebuild": "pnpm --filter @gulio/config --filter @gulio/contracts --filter @gulio/database run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"worker tests: pending\""
  },
  "dependencies": {
    "@gulio/config": "workspace:*",
    "@gulio/contracts": "workspace:*",
    "@gulio/database": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@gulio/typescript-config": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
