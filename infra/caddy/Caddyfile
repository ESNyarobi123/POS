# GulioSmart POS — TLS edge for bare public IP
# Mount openssl certs at /etc/caddy/certs/{cert,key}.pem (IP SAN).
# Browsers show a warning for self-signed until a domain + Let's Encrypt is used.

{
	auto_https off
	servers {
		protocols h1 h2
	}
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	encode gzip

	# Browser API base: https://IP/api → Nest routes at /
	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
