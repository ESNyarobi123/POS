# GulioSmart POS — production edge
# Domain: tz.pos.guliosmart.com (Cloudflare proxy → origin)
#
# Preferred: Let's Encrypt automatic HTTPS (DNS must reach this host on :80,
# or set Cloudflare record to DNS-only while issuing / renewing).
# Fallback: mount openssl certs and set tls lines below.

{
	email admin@guliosmart.com
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_HOST} {
	encode gzip

	# Browser API base: https://host/api → Nest routes at /
	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
