# GulioSmart POS — production edge for tz.pos.guliosmart.com
# Let's Encrypt on HTTPS. HTTP also served (no forced redirect) so Cloudflare
# "Flexible" does not loop; set Cloudflare SSL/TLS to Full (strict) in prod.

{
	email admin@guliosmart.com
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://{$PUBLIC_HOST} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}

https://{$PUBLIC_HOST} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
