# GulioSmart POS — TLS edge for bare public IP
# PUBLIC_HOST from compose (e.g. 138.68.145.127)
# Certs: infra/caddy/certs/{cert,key}.pem (openssl self-signed with IP SAN)
# Browsers will warn until you add a real domain + Let's Encrypt.

{
	auto_https off
}

http://{$PUBLIC_HOST} {
	redir https://{$PUBLIC_HOST}{uri} permanent
}

https://{$PUBLIC_HOST} {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	encode gzip

	# Browser API base: https://IP/api → Nest routes at /
	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
