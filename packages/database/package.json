{
  "name": "@gulio/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "echo \"database tests: pending\""
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@gulio/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
