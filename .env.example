# GulioSmart POS — copy to .env (never commit secrets)

NODE_ENV=development

# Apps
# Primary web origin (comma-separated OK). Dev also allows :3000 and :3010 in API CORS.
WEB_URL=http://localhost:3010
# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=http://127.0.0.1:3010
# NestJS listen port (4000 is often busy locally — prefer 4010)
API_URL=http://localhost:4010
API_PORT=4010
# Next.js web client (apps/web/.env.local) — browser calls this origin
NEXT_PUBLIC_API_URL=http://localhost:4010

# PostgreSQL (Docker Compose maps host 5434 → container 5432)
DATABASE_URL=postgresql://gulio:gulio@localhost:5434/guliosmart_pos?schema=public

# Redis / BullMQ (Docker Compose maps host 6380 → container 6379; avoids clash with local redis on 6379)
REDIS_URL=redis://localhost:6380

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=guliosmart-pos
S3_REGION=us-east-1

# Integrations (Phase 2+)
GULIOSMART_API_URL=
GULIOSMART_WEBHOOK_SECRET=
FISCAL_PROVIDER=mock
